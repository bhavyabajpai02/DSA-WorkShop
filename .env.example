VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: URL of your own secure server-side classifier endpoint (no provider API key in frontend env).
# Expected POST response: { "classifications": [{ "question_id": "...", "topic": "...", "pattern": "..." }] }
# VITE_AI_CLASSIFICATION_ENDPOINT=

# Optional: public JSON catalogue endpoint controlled by you; no platform credentials.
# Accepts an array or { "questions": [...] } with id, title, url, platform,
# topic, pattern, and difficulty (Easy, Medium, Hard). The built-in curated
# LeetCode snapshot is used if this endpoint is unset or unavailable.
# VITE_EXTERNAL_QUESTION_CATALOG_URL=
